{
  "Attachment_Data": {
    "$FOR_EACH_SCHEMA_ID$": {
      "schema_id": "«attachment_table»",
      "mapping": {
        "Encoding": "base64",
        "Filename": "@{«name_field»}",
        "Content_Type": "@{«mime_field»}",
        "File_Content": {
          "$FETCH_DOCUMENT_CONTENT$": {
            "datapoint": "«content_url_field»"
          }
        }
      }
    }
  }
}
