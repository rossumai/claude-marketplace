{
  "name": "PO line match — tag goods/service type",
  "source": {
    "dataset": "«po_dataset»",
    "queries": [
      {
        "aggregate": [
          {
            "$match": {
              "Document_Number": "{item_order_id}",
              "Supplier_Reference.ID.type": "Supplier_ID",
              "Supplier_Reference.ID._value_1": "{supplier_wd}"
            }
          },
          {
            "$addFields": {
              "__goods": {
                "$map": {
                  "input": {"$ifNull": ["$Goods_Line_Data", []]},
                  "in": {"$mergeObjects": [{"_type": "«goods_order_type_id»"}, "$$this"]}
                }
              },
              "__services": {
                "$map": {
                  "input": {"$ifNull": ["$Service_Line_Data", []]},
                  "in": {"$mergeObjects": [{"_type": "«service_order_type_id»"}, "$$this"]}
                }
              }
            }
          },
          {"$addFields": {"__lines": {"$concatArrays": ["$__services", "$__goods"]}}},
          {"$unwind": {"path": "$__lines"}},
          {"$addFields": {"__invoice_amount": {"$toDecimal": "{item_total_base}"}}},
          {
            "$match": {
              "$expr": {"$eq": [{"$toDecimal": "$__lines.Extended_Amount"}, "$__invoice_amount"]}
            }
          },
          {
            "$project": {
              "__lines._type": 1,
              "__lines.Line_Number": 1,
              "__lines.Quantity": 1,
              "__lines.Unit_Cost": 1,
              "__lines.Extended_Amount": 1,
              "__lines.Description": 1,
              "Document_Number": 1
            }
          }
        ]
      },
      {
        "aggregate": [
          {
            "$match": {
              "Document_Number": "{item_order_id}",
              "Supplier_Reference.ID.type": "Supplier_ID",
              "Supplier_Reference.ID._value_1": "{supplier_wd}"
            }
          },
          {
            "$addFields": {
              "__goods": {
                "$map": {
                  "input": {"$ifNull": ["$Goods_Line_Data", []]},
                  "in": {"$mergeObjects": [{"_type": "«goods_order_type_id»"}, "$$this"]}
                }
              },
              "__services": {
                "$map": {
                  "input": {"$ifNull": ["$Service_Line_Data", []]},
                  "in": {"$mergeObjects": [{"_type": "«service_order_type_id»"}, "$$this"]}
                }
              }
            }
          },
          {"$addFields": {"__lines": {"$concatArrays": ["$__services", "$__goods"]}}},
          {"$unwind": {"path": "$__lines"}},
          {
            "$project": {
              "__lines._type": 1,
              "__lines.Line_Number": 1,
              "__lines.Quantity": 1,
              "__lines.Unit_Cost": 1,
              "__lines.Extended_Amount": 1,
              "__lines.Description": 1,
              "Document_Number": 1
            }
          }
        ]
      }
    ]
  },
  "mapping": {
    "dataset_key": "__lines.Line_Number",
    "label_template": "{Document_Number} - Line: {__lines.Line_Number}",
    "target_schema_id": "item_order_line_nr_wd"
  },
  "result_actions": {
    "no_match_found": {
      "select": "default",
      "message": {"type": "error", "content": "PO line match not found."}
    },
    "one_match_found": {"select": "best_match"},
    "multiple_matches_found": {
      "select": "best_match",
      "message": {"type": "warning", "content": "Multiple PO line matches — best match preselected."}
    }
  },
  "additional_mappings": [
    {"dataset_key": "__lines._type", "target_schema_id": "item_order_type_wd"},
    {"dataset_key": "__lines.Quantity", "target_schema_id": "item_po_quantity"},
    {"dataset_key": "__lines.Unit_Cost", "target_schema_id": "item_po_unit_cost"},
    {"dataset_key": "__lines.Extended_Amount", "target_schema_id": "item_order_line_amount"},
    {"dataset_key": "Document_Number", "target_schema_id": "item_document_number_po_wd"}
  ]
}
